<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para Victoria</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #ffe5ec, #ffb3c6, #fbc4ab);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Georgia', serif;
            overflow: hidden;
            position: relative;
        }

        .container {
            text-align: center;
            position: relative;
            z-index: 10;
            background: rgba(255, 255, 255, 0.55);
            padding: 25px;
            border-radius: 24px;
            backdrop-filter: blur(8px);
            box-shadow: 0 10px 30px rgba(217, 4, 41, 0.1);
            max-width: 85%;
            animation: containerFade 1.5s ease-out;
        }

        @keyframes containerFade {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Contenedor del Corazón */
        .heart-shape {
            position: relative;
            width: 220px;
            height: 220px;
            margin: 0 auto 30px auto;
            animation: pulse 1.2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.06); }
            100% { transform: scale(1); }
        }

        /* Flores del corazón */
        .flower {
            position: absolute;
            font-size: 38px;
            filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.12));
        }

        /* Distribución exacta en forma de corazón */
        .f1 { top: -25px; left: 55px; }
        .f2 { top: -25px; left: 125px; }
        .f3 { top: 5px; left: 10px; }
        .f4 { top: 5px; left: 170px; }
        .f5 { top: 55px; left: -25px; }
        .f6 { top: 55px; left: 205px; }
        .f7 { top: 115px; left: 5px; }
        .f8 { top: 115px; left: 175px; }
        .f9 { top: 165px; left: 45px; }
        .f10 { top: 165px; left: 135px; }
        .f11 { top: 205px; left: 90px; }

        /* Estilo del Nombre */
        h1 {
            color: #d90429;
            font-size: 3rem;
            margin: 0 0 15px 0;
            text-shadow: 2px 3px 6px rgba(0, 0, 0, 0.08);
            letter-spacing: 2px;
        }

        /* Estilo del Poema */
        .poem-box {
            color: #4a0004;
            font-size: 1.15rem;
            line-height: 1.6;
            margin: 0 auto;
            font-style: italic;
        }

        .poem-line {
            opacity: 0;
            animation: fadeInLine 1.5s ease-in-out forwards;
            margin: 6px 0;
        }

        /* Tiempos de aparición para cada verso */
        .l1 { animation-delay: 0.8s; }
        .l2 { animation-delay: 2.2s; }
        .l3 { animation-delay: 3.6s; }
        .l4 { animation-delay: 5s; }

        @keyframes fadeInLine {
            to { opacity: 1; }
        }

        /* Animación de pétalos cayendo de fondo */
        .petal {
            position: absolute;
            top: -50px;
            font-size: 20px;
            user-select: none;
            pointer-events: none;
            animation: fall linear infinite;
        }

        @keyframes fall {
            0% {
                top: -50px;
                transform: translateX(0) rotate(0deg);
                opacity: 1;
            }
            100% {
                top: 105vh;
                transform: translateX(100px) rotate(360deg);
                opacity: 0;
            }
        }

        /* Nota flotante para activar música */
        .music-tip {
            position: fixed;
            bottom: 15px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.85rem;
            color: #8a5a65;
            background: rgba(255,255,255,0.7);
            padding: 5px 12px;
            border-radius: 20px;
            pointer-events: none;
            z-index: 100;
        }
    </style>
</head>
<body>

    <!-- Melodía instrumental de piano de Photograph de Ed Sheeran -->
    <audio autoplay loop id="bg-music">
        <source src="https://soundhelix.com" type="audio/mpeg">
    </audio>

    <div class="music-tip">🎵 Toca cualquier parte si no escuchas la música</div>

    <div class="container">
        <!-- Corazón de flores -->
        <div class="heart-shape">
            <span class="flower f1">🌸</span>
            <span class="flower f2">🌸</span>
            <span class="flower f3">🌹</span>
            <span class="flower f4">🌹</span>
            <span class="flower f5">🌻</span>
            <span class="flower f6">🌻</span>
            <span class="flower f7">🌺</span>
            <span class="flower f8">🌺</span>
            <span class="flower f9">🌷</span>
            <span class="flower f10">🌷</span>
            <span class="flower f11">💝</span>
        </div>

        <h1>Victoria</h1>
        
        <!-- Hermoso Poema Corto -->
        <div class="poem-box">
            <div class="poem-line l1">Entre flores y versos te pienso,</div>
            <div class="poem-line l2">con una sonrisa que no tiene fin.</div>
            <div class="poem-line l3">Guardamos el amor en este silencio,</div>
            <div class="poem-line l4">eres la luz de mi propio jardín. ✨</div>
        </div>
    </div>

    <script>
        // Animación de los pétalos de rosa y destellos flotando
        const petalTypes = ['🌸', '🌹', '✨', '💖'];
        function createPetal() {
            const petal = document.createElement('div');
            petal.classList.add('petal');
            petal.innerText = petalTypes[Math.floor(Math.random() * petalTypes.length)];
            petal.style.left = Math.random() * 100 + 'vw';
            petal.style.animationDuration = Math.random() * 3 + 4 + 's'; 
            petal.style.fontSize = Math.random() * 12 + 16 + 'px';
            document.body.appendChild(petal);

            setTimeout(() => {
                petal.remove();
            }, 7000);
        }
        setInterval(createPetal, 450);

        // Los navegadores móviles exigen que el usuario toque la pantalla para iniciar la música
        document.body.addEventListener('click', () => {
            const audio = document.getElementById('bg-music');
            audio.play();
            document.querySelector('.music-tip').style.display = 'none';
        }, { once: true });
    </script>
</body>
</html>
